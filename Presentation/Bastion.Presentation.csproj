<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bastion.Presentation</RootNamespace>
    <AssemblyName>Bastion.Presentation</AssemblyName>

    <!-- Regla 5 del estandar del equipo: WCF resuelve por reflexion y el
         recortador elimina codigo que si hace falta. El fallo aparece en
         ejecucion, no al compilar. No activar ninguna de las dos. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Regla 1: DesktopGL, nunca WindowsDX. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resources\Bastion.Resources.csproj" />
  </ItemGroup>

</Project>
