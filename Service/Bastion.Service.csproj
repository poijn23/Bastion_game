<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Servidor de cuentas sobre CoreWCF y net.tcp. Es el unico proceso que
    referencia DataAccess: el cliente llega por el contrato (DRV-01).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bastion.Service</RootNamespace>
    <AssemblyName>Bastion.Service</AssemblyName>

    <!-- Regla del equipo: CoreWCF resuelve por reflexion y el recortador
         borra codigo que si hace falta. El fallo sale en ejecucion. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreWCF.NetTcp" Version="1.9.0" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Bastion.Contracts.csproj" />
    <ProjectReference Include="..\DataAccess\Bastion.DataAccess.csproj" />
    <ProjectReference Include="..\Domain\Bastion.Domain.csproj" />
  </ItemGroup>

</Project>
